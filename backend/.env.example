# Etsy App Credentials (from https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=your_etsy_keystring_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=https://hafeez45d.github.io/etsy-listing-studio/

# Encryption secret for token storage (AES-256-GCM)
ENCRYPTION_SECRET=change-this-to-a-random-string

# Server port (optional, defaults to 3000)
PORT=3000
